    public static GLib.Variant from_layout (string layout, string? variant = null) {
        var name = layout;
        var classification = layout;
        if (variant != null && variant.length > 0) {
            name += "+" + variant;
            classification += "(" + variant + ")";
        }
        GLib.Variant[] sources = {};
        if (classification in NON_LATIN_LAYOUTS) {
            // Retain the installer's US fallback for names and passwords.
            sources += new GLib.Variant ("(ss)", "xkb", "us");
        }
        sources += new GLib.Variant ("(ss)", "xkb", name);
        return new GLib.Variant.array (new GLib.VariantType ("(ss)"), sources);
    }
